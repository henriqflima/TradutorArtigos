{
  "name": "lume-tradutor",
  "description": "Tradução de textos e artigos em PDF, com revisão de layout, exportação em Word e PDF e resumos com referências às páginas de origem.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "@mathjax/mathjax-tex-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@pdf-lib/fontkit": "1.1.1",
    "docx-preview": "^0.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.46.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.6.205",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@netlify/vite-plugin": "^3.0.1",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
