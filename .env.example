# Server only. Never prefix this with VITE_. Requires API access to gpt-6.1-terra.
OPENAI_API_KEY=
# Independent article summaries: override only with a model supporting images, structured outputs and web search.
SUMMARY_MODEL=gpt-6.1-terra
# Server only. Requires API access to Mistral OCR. Never use the VITE_ prefix.
MISTRAL_API_KEY=
# Optional: pin a model for diagnosis; defaults to the latest OCR model.
MISTRAL_OCR_MODEL=mistral-ocr-latest
# Optional shared access code; strongly recommended before sharing a paid endpoint.
APP_ACCESS_CODE=
